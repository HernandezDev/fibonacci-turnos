{
	"name": "fibonacci-turnos",
	"description": "applicacion para instituto de clases particulares",
	"dependencies": {
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.53.0",
		"@eslint/js": "9.39.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.5",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "^8.2.1",
		"wrangler": "4.124.0"
	},
	"private": true,
	"scripts": {
		"prepare": "pnpm run cf-typegen",
		"cf-typegen": "wrangler types",
		"dev": "vite",
		"build": "tsc -b && vite build && cp -r dist/landing dist/client/landing",
		"check": "tsc -b && vite build && pnpm exec wrangler deploy --dry-run",
		"deploy": "pnpm run build && pnpm exec wrangler deploy",
		"lint": "eslint .",
		"preview": "pnpm run build && vite preview"
	},
	"type": "module"
}
